# Copie este ficheiro para .env e preencha os dados da sua instalação
APP_NAME="Leitor Biblico"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Bible-niv
APP_TIMEZONE=Africa/Luanda

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bible_reader
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Ficheiro SQL opcional com CREATE/INSERT da transcription_table
TRANSCRIPTION_SQL_FILE=schema/transcription_table.sql
